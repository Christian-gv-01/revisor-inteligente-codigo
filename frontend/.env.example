# Opcional. Vacío utiliza /api mediante el proxy local de Vite.
# Nunca colocar claves de IA ni secretos en variables VITE_.
VITE_API_BASE_URL=
# Mantener junto a PROJECT_BUDGET_ENABLED=1 en el backend.
VITE_PROJECT_BUDGET_ENABLED=1
# Confirmación explícita para descargar una copia; nunca ejecutar ni sobrescribir.
VITE_CORRECTIONS_API_ENABLED=1
