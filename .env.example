# Proveedor principal
LLM_PROVIDER=gemini
GEMINI_MODEL=

# Proveedor de respaldo
LLM_FALLBACK_PROVIDER=groq
GROQ_MODEL=

# Credenciales (solo valores reales en .env)
GEMINI_API_KEY=
GROQ_API_KEY=

# Control de ejecución
LLM_TIMEOUT_SECONDS=20
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TEMPERATURE=0.2
# Numero total de intentos por llamada logica (1..3); incluye el inicial.
LLM_RETRY_ATTEMPTS=2
# Plazos compartidos: espera + intentos + fases. No se amplian por archivo.
# Valores superiores quedan acotados a 45/150/150 segundos.
ANALYSIS_TOTAL_SECONDS=45
AGENT_TOTAL_SECONDS=150
PROJECT_TOTAL_SECONDS=150

# Indice RAG: en local se usa ./data/chroma si queda vacio.
# En despliegue indicar ruta absoluta de un volumen persistente.
CHROMA_PATH=
RAG_MAX_DISTANCE=0.75

# Proteccion de endpoints costosos en produccion.
RATE_LIMIT_ENABLED=0
# Limita tareas costosas concurrentes (maximo dos por proceso).
CONCURRENCY_LIMIT_ENABLED=0
# Solo 1 cuando el ingreso al backend sea EXCLUSIVAMENTE por el proxy publico.
# Con trafico interno o acceso directo mantener 0.
TRUST_RAILWAY_REAL_IP=0
# Agrega el informe Ruff/Bandit a las modalidades originales.
STATIC_ANALYSIS_ENABLED=0


# Propuestas temporales: por defecto junto al índice Chroma.
CORRECTIONS_DB_PATH=
# Cookie Secure predeterminada al servir frontend; usar 0 solo con HTTP local.
# CORRECTIONS_COOKIE_SECURE=0
# Frontend: requiere reiniciar Vite o recompilar. Deshabilitado por defecto.
VITE_CORRECTIONS_API_ENABLED=0
# Proxy Vite opcional para un backend local en otro puerto.
# CODEGUARD_DEV_API_TARGET=http://127.0.0.1:8000
