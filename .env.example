# Proveedor principal
LLM_PROVIDER=gemini
GEMINI_MODEL=

# Proveedor de respaldo
LLM_FALLBACK_PROVIDER=groq
GROQ_MODEL=

# Credenciales (solo valores reales en .env)
GEMINI_API_KEY=
GROQ_API_KEY=

# Control de ejecución
LLM_TIMEOUT_SECONDS=20
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TEMPERATURE=0.2
LLM_MAX_RETRIES=2